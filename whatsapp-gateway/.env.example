# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace_with_random_verify_token
WHATSAPP_ACCESS_TOKEN=replace_with_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_phone_number_id
WHATSAPP_GRAPH_VERSION=v26.0

# Safe-by-default sender policy.
# Comma-separated phone numbers in international format without +.
WHATSAPP_ALLOWED_NUMBERS=48123456789
# Set to true only if you intentionally want Jarvis to answer every sender.
WHATSAPP_ALLOW_ALL=false

# Jarvis brain endpoint.
# It should accept POST JSON:
# { "text": "...", "from": "...", "channel": "whatsapp", "message_id": "..." }
# and return JSON with reply/text/message, or plain text.
JARVIS_BRAIN_URL=https://your-jarvis-brain.example.com/api/chat
JARVIS_BRAIN_TOKEN=
# Optional fixed reply for first integration test if the brain endpoint is not ready yet.
JARVIS_TEST_REPLY=

# Fish Audio TTS
FISH_API_KEY=replace_with_fish_audio_api_key
FISH_VOICE_ID=replace_with_your_jarvis_voice_reference_id
FISH_MODEL=s2.1-pro-free
