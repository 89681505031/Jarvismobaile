+    private fun selectBestSpeech(results: Bundle?, preferWakeWord: Boolean): String {
+        val candidates = results
+            ?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)
+            ?.map { it.trim() }
+            ?.filter { it.isNotBlank() }
+            .orEmpty()
+        if (candidates.isEmpty()) return ""
+
+        val confidence = results?.getFloatArray(SpeechRecognizer.CONFIDENCE_SCORES)
+        val best = candidates.mapIndexed { index, candidate ->
+            var score = confidence?.getOrNull(index)?.takeIf { it >= 0f } ?: (1f - index * 0.05f)
+            if (preferWakeWord && startsWithWakeWord(candidate)) score += 2f
+            candidate to score
+        }.maxByOrNull { it.second }?.first ?: candidates.first()
+
+        return normalizeWakeAlias(best)
+    }
+
+    private fun startsWithWakeWord(text: String): Boolean {
