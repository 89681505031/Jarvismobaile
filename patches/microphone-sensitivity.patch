+            .trim(',', '.', '!', '?', ':', ';')
+        return firstWord in setOf(
+            "джарвис", "jarvis", "джервис", "жарвис", "джарвес", "джаврис",
+            "астра", "astra", "луна", "luna", "сайбер", "cyber", "терра", "terra"
+        )
+    }
+
+    private fun normalizeWakeAlias(text: String): String {
+        val alias = Regex(
+            "^\\s*(джервис|жарвис|джарвес|джаврис)(?=[\\s,.!?;:]|$)",
+            RegexOption.IGNORE_CASE
+        )
+        return alias.replaceFirst(text.trim(), "джарвис")
+    }
+
